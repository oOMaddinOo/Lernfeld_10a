        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initMapWithGeolocate", dotNetRef);
        }
    }

    public ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Manuelle Aktualisierung: löscht den Cache-Eintrag für die aktuell
    /// angezeigte Stadt und lädt frische Daten aus der DB. Wird vom
    /// "Frische Daten laden"-Button im Side-Panel aufgerufen.
    ///
    /// Hintergrund: kloService cached jede Stadt 7 Tage lang im Memory.
    /// Wenn neue Toiletten / Trinkbrunnen in die DB geschrieben werden
    /// (z. B. via SQL-Seed), tauchen sie erst nach Cache-Ablauf oder
    /// einem Neustart auf — oder eben über diesen Button.
    /// </summary>
    private async Task RefreshCurrentCity()
    {
        if (string.IsNullOrWhiteSpace(cityInput)) return;

        // Gleiche Normalisierung wie in SearchAllActive, damit wir den
        // tatsächlich verwendeten Cache-Key treffen ("hamburg" → "Hamburg").
        var city = cityInput.Trim();
        city = char.ToUpper(city[0]) + city.Substring(1).ToLower();
        await SearchAllActive();
    }

