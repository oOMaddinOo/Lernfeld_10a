@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Caching.Memory
@inject IJSRuntime JS
@inject kloService kloService
@inject IWebHostEnvironment WebHostEnv
@inject IGeocodingService GeocodingService
@implements IAsyncDisposable
@rendermode InteractiveServer

<Title>WaterDrop</Title>


<div id="map"></div>


<aside class="wd-panel">
    <div class="wd-header">
        <div class="wd-app-name">WaterDrop</div>
        <div class="wd-app-sub">Restrooms &amp; Facilities</div>
    </div>

    <div class="wd-search-wrap">
        <input id="citySearchInput"
               type="text"
               class="wd-search-input"
               value="@cityInput"
               placeholder="Search city or address&hellip;"
               @onchange="@(e => cityInput = e.Value?.ToString() ?? "")"
               @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchAllActive(); })" />
    </div>

    @if (GeolocationStatusText() is { } statusText)
    {
        <div class="wd-geo-status">@statusText</div>
    }

    <div class="wd-filters-label">FILTERS</div>

    <div class="wd-filter-rows">
        @foreach (var cat in categories)
        {
            var catKey = cat.Key;
            <div class="wd-filter-row">
                <div class="wd-filter-icon" style="background:@cat.Color;"></div>
                <div class="wd-filter-info">
                    <span class="wd-filter-name">@cat.Label</span>
                    @if (loadingStates[cat.Key])
                    {
                        <span class="wd-filter-count">Loading&hellip;</span>
                    }
                    else if (!string.IsNullOrEmpty(errorStates[cat.Key]))
                    {
                        <span class="wd-filter-count wd-error">@errorStates[cat.Key]</span>
                    }
                    else if (counts[cat.Key] >= 0)
                    {
                        <span class="wd-filter-count">@counts[cat.Key] found</span>
                    }
                </div>
                <label class="wd-toggle">
                    <input type="checkbox"
                           checked="@toggleStates[catKey]"
                           @onchange="@(async (ChangeEventArgs e) => await OnToggleChanged(catKey, (bool)(e.Value ?? false)))" />
                    <span class="wd-slider"></span>
                </label>
            </div>
        }
    </div>

    @if (nearbyFacilities.Count > 0)
    {
        <div class="wd-filters-label">NEARBY</div>
        <div class="wd-nearby-list">
            @foreach (var fac in nearbyFacilities)
            {
                var facId = fac.Id;
                var isDrinking = fac.Amenity == "drinking_water";
                <button class="wd-nearby-item" @onclick="@(async () => await JS.InvokeVoidAsync("selectFacilityById", facId))">
                    <span class="wd-nearby-dot" style="background:@(isDrinking ? "#4E9FD4" : "#3461C1");"></span>
                    <span class="wd-nearby-info">
                        <span class="wd-nearby-name">@fac.Name</span>
                        <span class="wd-nearby-dist">@FormatDistance(fac.Distance)</span>
                    </span>
                </button>
            }
        </div>
    }

    <button class="wd-search-btn" @onclick="SearchAllActive">Search this area</button>
</aside>

<div class="wd-mobile-topbar">
    <button class="wd-icon-btn" @onclick="ToggleBottomSheet">&#9776;</button>
    <input id="citySearchInputMobile"
           type="text"
           class="wd-mobile-search"
           value="@cityInput"
           placeholder="Search city or address&hellip;"
           @onchange="@(e => cityInput = e.Value?.ToString() ?? "")"
           @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchAllActive(); })" />
    <button class="wd-icon-btn" @onclick="LocateUser">&#8982;</button>
</div>

<div class="wd-bottom-sheet @(bottomSheetVisible ? "open" : "")">
    <div class="wd-drag-handle"></div>
    <div class="wd-sheet-title">Find Restrooms &amp; Water in @(string.IsNullOrEmpty(cityInput) ? "your area" : cityInput)</div>

    @foreach (var cat in categories)
    {
        var catKey = cat.Key;
        var isActive = toggleStates[cat.Key];
        <button class="wd-cat-btn"
                style="background:@(isActive ? cat.Color : "#efefef"); color:@(isActive ? "white" : "#333");"
                @onclick="@(async () => await ToggleMobileCategory(catKey))">
            <span>@cat.Label</span>
            <span class="wd-cat-count">
                @if (loadingStates[cat.Key])
                {
                    <span>&#8987;</span>
                }
                else if (counts[cat.Key] >= 0)
                {
                    <span>@counts[cat.Key]</span>
                }
            </span>
        </button>
    }

    <button class="wd-search-btn wd-sheet-search-btn" @onclick="SearchAllActive">Search this area</button>

    <div class="wd-bottom-nav">
        <div class="wd-bottom-nav-item active">
            <span>&#128506;</span>
            <span>Map</span>
        </div>
        <div class="wd-bottom-nav-item">
            <span>&#9881;</span>
            <span>Settings</span>
        </div>
    </div>
</div>

<button class="wd-locate-fab" @onclick="LocateUser" title="My location">&#8982;</button>

@if (showSearchAreaBtn)
{
    <button class="wd-search-area-pill" @onclick="SearchByMapBounds">Search this area</button>
}

@if (TotalCount > 0)
{
    <div class="wd-total-badge">@TotalCount results</div>
}

@* ===== Facility Detail Card (info-first, like Google Maps) ===== *@
@if (detailCardVisible)
{
    <div class="wd-detail-card">
        <button class="wd-detail-close" @onclick="CloseDetailCard">&times;</button>

        <div class="wd-detail-type">
            <span class="wd-detail-type-dot" style="background:@selectedFacilityColor;"></span>
            @selectedFacilityType
        </div>

        <div class="wd-detail-name">@selectedFacilityName</div>

        @if (selectedDistance >= 0)
        {
            <div class="wd-detail-distance">@FormatDistance(selectedDistance) away</div>
        }

        @if (!string.IsNullOrEmpty(selectedAddress))
        {
            <div class="wd-detail-row">
                <span class="wd-detail-row-icon">&#128205;</span>
                <span>@selectedAddress</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(selectedOpeningHours))
        {
            <div class="wd-detail-row">
                <span class="wd-detail-row-icon">&#128336;</span>
                <span>@selectedOpeningHours</span>
            </div>
        }

        <div class="wd-detail-badges">
            @if (selectedWheelchair == true)
            {
                <span class="wd-badge wd-badge-green">&#9855; Accessible</span>
            }
            @if (selectedFee == true)
            {
                <span class="wd-badge wd-badge-amber">Paid</span>
            }
            else if (selectedFee == false)
            {
                <span class="wd-badge wd-badge-green">Free</span>
            }
            @if (selectedReviewCount > 0)
            {
                <span class="wd-badge wd-badge-blue">@selectedReviewCount review@(selectedReviewCount != 1 ? "s" : "")</span>
            }
        </div>

        <div class="wd-detail-actions">
            @if (selectedLat.HasValue && selectedLon.HasValue)
            {
                <a class="wd-detail-action" href="@GetDirectionsUrl()" target="_blank" rel="noopener noreferrer">
                    <span class="wd-detail-action-icon">&#128204;</span>
                    <span>Directions</span>
                </a>
            }
            <button class="wd-detail-action" @onclick="OpenReviewFromCard">
                <span class="wd-detail-action-icon">&#9997;</span>
                <span>Review</span>
            </button>
            <button class="wd-detail-action" @onclick="OpenHistoryPanel">
                <span class="wd-detail-action-icon">&#128172;</span>
                <span>@(selectedReviewCount > 0 ? $"All ({selectedReviewCount})" : "Reviews")</span>
            </button>
        </div>
    </div>
}

@* ===== Review Panel (opens from detail card) ===== *@
@if (reviewPanelVisible)
{
    <div class="wd-review-panel open">
        <div class="wd-review-header">
            <div class="wd-review-title">Review — @selectedFacilityName</div>
            <button class="wd-review-close" @onclick="CloseReviewPanel">&times;</button>
        </div>
        <div class="wd-review-body">
            <label class="wd-review-label">Your Review</label>
            <textarea class="wd-review-textarea"
                      @bind="reviewText"
                      placeholder="Write your review here..."></textarea>

            <label class="wd-review-label">Photo (optional)</label>
            @if (!string.IsNullOrEmpty(pendingPictureUrl))
            {
                <div class="wd-review-image-preview">
                    <img src="@pendingPictureUrl" alt="Preview" />
                    <button type="button" class="wd-review-image-swap" @onclick="SwapImage">
                        Change photo
                    </button>
                </div>
            }
            else
            {
                <InputFile OnChange="HandleImageUpload"
                           accept="image/jpeg,image/png,image/webp"
                           class="wd-review-file-input" />
                @if (uploadingImage)
                {
                    <div class="wd-review-uploading">Uploading...</div>
                }
                @if (!string.IsNullOrEmpty(uploadErrorMessage))
                {
                    <div class="wd-review-error">@uploadErrorMessage</div>
                }
            }

            <button class="wd-review-save-btn" @onclick="SaveReview">Send Review</button>

            @if (!string.IsNullOrEmpty(reviewSaveMessage))
            {
                <div class="wd-review-feedback">@reviewSaveMessage</div>
            }
        </div>
    </div>
}

@if (historyPanelVisible)
{
    <div class="wd-history-panel open">
        <div class="wd-history-header">
            <div class="wd-history-title">Alle Reviews — @selectedFacilityName</div>
            <button class="wd-history-close" @onclick="CloseHistoryPanel">&times;</button>
        </div>
        <div class="wd-history-body">
            @if (loadingHistory)
            {
                <div class="wd-history-loading">Lade Reviews…</div>
            }
            else if (historyReviews == null || historyReviews.Count == 0)
            {
                <div class="wd-history-empty">
                    Für diesen Ort gibt es noch keine Reviews.
                </div>
            }
            else
            {
                @foreach (var review in historyReviews)
                {
                    <div class="wd-history-item">
                        <div class="wd-history-item-date">
                            @(review.CreatedAt.HasValue
                                ? review.CreatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                : "Datum unbekannt")
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <div class="wd-history-item-comment">@review.Comment</div>
                        }
                        @if (!string.IsNullOrEmpty(review.PictureUrl))
                        {
                            <img class="wd-history-item-image" src="@review.PictureUrl" alt="Review picture" />
                        }
                    </div>
                }
            }
        </div>
    </div>
}


@code {
    private record CategoryDef(string Key, string Label, string Color);

    private List<CategoryDef> categories = new()
    {
        new("restrooms",      "Restrooms",      "#3461C1"),
        new("drinking_water", "Drinking Water", "#4E9FD4"),
        new("accessible",     "Accessible",     "#5BA85A"),
        new("changing_table", "Changing Table", "#E8A030"),
    };

    private string cityInput = string.Empty;
    private bool bottomSheetVisible = false;
    private bool showSearchAreaBtn = false;
    private DotNetObjectReference<Home>? dotNetRef;

    private Dictionary<string, bool> toggleStates = new()
    {
        ["restrooms"]      = true,
        ["drinking_water"] = true,
        ["accessible"]     = true,
        ["changing_table"] = true,
    };

    private Dictionary<string, int> counts = new()
    {
        ["restrooms"]      = -1,
        ["drinking_water"] = -1,
        ["accessible"]     = -1,
        ["changing_table"] = -1,
    };

    private Dictionary<string, bool> loadingStates = new()
    {
        ["restrooms"]      = false,
        ["drinking_water"] = false,
        ["accessible"]     = false,
        ["changing_table"] = false,
    };

    private Dictionary<string, string> errorStates = new()
    {
        ["restrooms"]      = "",
        ["drinking_water"] = "",
        ["accessible"]     = "",
        ["changing_table"] = "",
    };

    private int TotalCount => counts.Values.Where(v => v >= 0).Sum();

    // Nearby facilities list
    private record NearbyFacility(string Id, string Name, double Lat, double Lon, double Distance, string Amenity);
    private List<NearbyFacility> nearbyFacilities = new();

    private string FormatDistance(double meters)
    {
        if (meters < 1000) return $"{(int)meters}m";
        return $"{(meters / 1000):0.#}km";
    }

    private void ToggleBottomSheet() => bottomSheetVisible = !bottomSheetVisible;

    private async Task LocateUser()
    {
        await JS.InvokeVoidAsync("locateUser");
    }

    private async Task OnToggleChanged(string category, bool enabled)
    {
        toggleStates[category] = enabled;
        if (enabled)
        {
            var hasData = await JS.InvokeAsync<bool>("categoryHasData", category);
            if (hasData)
                await JS.InvokeVoidAsync("showCategoryLayer", category);
            else if (!string.IsNullOrWhiteSpace(cityInput))
                await FetchCategory(category);
        }
        else
        {
            await JS.InvokeVoidAsync("hideCategoryLayer", category);
        }
    }

    private async Task ToggleMobileCategory(string category)
    {
        var newState = !toggleStates[category];
        await OnToggleChanged(category, newState);
    }

    private async Task SearchAllActive()
    {
        if (string.IsNullOrWhiteSpace(cityInput))
            return;

        cityInput = cityInput.Trim();
        cityInput = char.ToUpper(cityInput[0]) + cityInput.Substring(1).ToLower();

        foreach (var cat in categories.Select(c => c.Key))
            await JS.InvokeVoidAsync("clearCategoryLayer", cat);

        // Fly the map to the searched city
        var bbox = await GeocodingService.GetCityBoundingBoxAsync(cityInput);
        if (bbox != null)
            await JS.InvokeVoidAsync("fitMapToBounds", bbox.MinLat, bbox.MinLon, bbox.MaxLat, bbox.MaxLon);

        var activeCats = toggleStates.Where(kv => kv.Value).Select(kv => kv.Key).ToList();

        foreach (var cat in activeCats)
        {
            loadingStates[cat] = true;
            errorStates[cat] = "";
        }
        showSearchAreaBtn = false;
        StateHasChanged();

        try
        {
            var elementDtos = new List<object>();

            // EIN einziger DB-Aufruf — `GetToiletsByCity` liefert alle Datensätze
            // im Stadt-Bounding-Box (Toiletten UND Trinkbrunnen).
            // Die Filterung nach Kategorie passiert clientseitig in `addCategoryElements`
            // anhand des amenity-Tags. Vorher wurde dieselbe Query zweimal aufgerufen,
            // was nur Duplikate erzeugte — und konnte zudem maskieren, ob drinking_water
            // überhaupt im Result enthalten ist.
            Console.WriteLine($"Lade alle Datensätze für Stadt: '{cityInput}'");

            var fetchResult = await kloService.GetToiletsByCity(cityInput);

            Console.WriteLine($"{fetchResult.Elements.Count} Datensätze erhalten (Toiletten + Trinkwasser zusammen)");

            // Diagnose: zählen, wie viele davon drinking_water sind, BEVOR sie ans
            // Frontend gehen. Wenn diese Zahl > 0 ist, aber das UI 0 anzeigt, liegt
            // das Problem zwischen Blazor → JS → Marker. Wenn schon hier 0, sind
            // die Seed-Daten nicht in der DB oder die Bounding-Box passt nicht.
            int dwCountBeforeJs = 0;
            foreach (var e in fetchResult.Elements)
            {
                if (e.Tags != null && e.Tags.TryGetValue("amenity", out var a) && a == "drinking_water")
                    dwCountBeforeJs++;

                var lat = e.Lat ?? e.Center?.Lat;
                var lon = e.Lon ?? e.Center?.Lon;
                if (lat.HasValue && lon.HasValue)
                    elementDtos.Add(new {
                        id = e.ElementId.ToString(),
                        lat = lat.Value,
                        lon = lon.Value,
                        tags = e.Tags ?? new Dictionary<string, string>()
                    });
            }

            Console.WriteLine($"Davon amenity=drinking_water: {dwCountBeforeJs} (vor JS-Übergabe)");
            Console.WriteLine($"Insgesamt {elementDtos.Count} Elemente ans Frontend");

            var result = await JS.InvokeAsync<Dictionary<string, int>>("addCategoryElements", elementDtos, activeCats);
            foreach (var cat in activeCats)
            {
                counts[cat] = result.TryGetValue(cat, out var c) ? c : 0;
                loadingStates[cat] = false;
            }

            await LoadNearbyList();
        }
        catch (Exception ex)
        {
            foreach (var cat in activeCats)
            {
                errorStates[cat] = "Error loading";
                loadingStates[cat] = false;
            }
            Console.WriteLine($"Error fetching categories: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task LoadNearbyList()
    {
        try
        {
            var items = await JS.InvokeAsync<List<NearbyFacility>>("getNearbyFacilities", 8);
            nearbyFacilities = items ?? new();
        }
        catch
        {
            nearbyFacilities = new();
        }
    }

    [JSInvokable]
    public Task ShowSearchAreaButton(bool show)
    {
        showSearchAreaBtn = show;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private record MapBounds(double MinLat, double MaxLat, double MinLon, double MaxLon);

    private async Task SearchByMapBounds()
    {
        showSearchAreaBtn = false;
        StateHasChanged();

        var bounds = await JS.InvokeAsync<MapBounds>("getMapBounds");
        if (bounds == null) return;

        foreach (var cat in categories.Select(c => c.Key))
            await JS.InvokeVoidAsync("clearCategoryLayer", cat);

        var activeCats = toggleStates.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        foreach (var cat in activeCats)
        {
            loadingStates[cat] = true;
            errorStates[cat] = "";
        }
        StateHasChanged();

        try
        {
            var fetchResult = await kloService.GetToiletsByBbox(
                bounds.MinLat, bounds.MaxLat, bounds.MinLon, bounds.MaxLon);

            var elementDtos = new List<object>();
            foreach (var e in fetchResult.Elements)
            {
                var lat = e.Lat ?? e.Center?.Lat;
                var lon = e.Lon ?? e.Center?.Lon;
                if (lat.HasValue && lon.HasValue)
                    elementDtos.Add(new {
                        id = e.ElementId.ToString(),
                        lat = lat.Value,
                        lon = lon.Value,
                        tags = e.Tags ?? new Dictionary<string, string>()
                    });
            }

            var result = await JS.InvokeAsync<Dictionary<string, int>>("addCategoryElements", elementDtos, activeCats);
            foreach (var cat in activeCats)
            {
                counts[cat] = result.TryGetValue(cat, out var c) ? c : 0;
                loadingStates[cat] = false;
            }

            await LoadNearbyList();
        }
        catch (Exception ex)
        {
            foreach (var cat in activeCats)
            {
                errorStates[cat] = "Error loading";
                loadingStates[cat] = false;
            }
            Console.WriteLine($"Error in SearchByMapBounds: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task FetchCategory(string category)
    {
        loadingStates[category] = true;
        errorStates[category] = "";
        StateHasChanged();

        try
        {
            var fetchResult = await kloService.GetToiletsByCity(cityInput);

            var elementDtos = new List<object>();
            foreach (var e in fetchResult.Elements)
            {
                var lat = e.Lat ?? e.Center?.Lat;
                var lon = e.Lon ?? e.Center?.Lon;
                if (lat.HasValue && lon.HasValue)
                    elementDtos.Add(new { id = e.ElementId.ToString(), lat = lat.Value, lon = lon.Value, tags = e.Tags ?? new Dictionary<string, string>() });
            }

            var countResult = await JS.InvokeAsync<Dictionary<string, int>>("addCategoryElements", elementDtos, new[] { category });
            counts[category] = countResult.TryGetValue(category, out var c) ? c : 0;
        }
        catch (Exception ex)
        {
            errorStates[category] = "Error loading";
            Console.WriteLine($"Error fetching {category}: {ex.Message}");
        }
        finally
        {
            loadingStates[category] = false;
            StateHasChanged();
        }
    }

    // Detail card state — shown on marker click (info-first, like Google Maps)
    private bool detailCardVisible = false;
    private long selectedElementId = 0;
    private string selectedFacilityName = string.Empty;
    private double? selectedLat = null;
    private double? selectedLon = null;
    private string selectedFacilityType = string.Empty;   // "Restroom" or "Drinking Fountain"
    private string selectedFacilityColor = "#3461C1";
    private string? selectedAddress = null;
    private string? selectedOpeningHours = null;
    private bool? selectedWheelchair = null;
    private bool? selectedFee = null;
    private int selectedReviewCount = 0;
    private double selectedDistance = -1; // meters, -1 = unknown

    // Review panel state — opens from detail card "Write Review" button
    private bool reviewPanelVisible = false;
    private string reviewText = string.Empty;
    private string reviewSaveMessage = string.Empty;

    // Image upload state
    private string? pendingPictureUrl = null;
    private bool uploadingImage = false;
    private string? uploadErrorMessage = null;
    private const long MaxImageSizeBytes = 5 * 1024 * 1024; // 5 MB

    // History panel state
    private bool historyPanelVisible = false;
    private bool loadingHistory = false;
    private List<DatabaseKloModel> historyReviews = new();

    [JSInvokable]
    public async Task OnMarkerSelected(string elementIdStr, string facilityName, double? lat, double? lon, Dictionary<string, string>? tags)
    {
        selectedElementId = long.Parse(elementIdStr);
        selectedFacilityName = facilityName;
        selectedLat = lat;
        selectedLon = lon;

        // Extract facility info from tags
        tags ??= new Dictionary<string, string>();
        var amenity = tags.GetValueOrDefault("amenity", "");
        if (amenity == "drinking_water")
        {
            selectedFacilityType = "Drinking Fountain";
            selectedFacilityColor = "#4E9FD4";
        }
        else
        {
            selectedFacilityType = "Public Restroom";
            selectedFacilityColor = "#3461C1";
        }

        // Address
        var parts = new List<string>();
        if (tags.TryGetValue("addr:street", out var street))
        {
            var addr = street;
            if (tags.TryGetValue("addr:housenumber", out var num)) addr += " " + num;
            parts.Add(addr);
        }
        if (tags.TryGetValue("addr:city", out var addrCity)) parts.Add(addrCity);
        selectedAddress = parts.Count > 0 ? string.Join(", ", parts) : null;

        selectedOpeningHours = tags.GetValueOrDefault("opening_hours");
        selectedWheelchair = tags.TryGetValue("wheelchair", out var wc) && wc == "yes" ? true : null;
        selectedFee = tags.ContainsKey("fee") ? tags["fee"] == "yes" : null;

        // Distance from user
        if (lat.HasValue && lon.HasValue)
            selectedDistance = await JS.InvokeAsync<double>("getDistanceFromUser", lat.Value, lon.Value);
        else
            selectedDistance = -1;

        // Load review count
        var reviews = await kloService.GetAllKlosByElementId(selectedElementId);
        selectedReviewCount = reviews.Count;

        // Close review panel if open, show detail card
        reviewPanelVisible = false;
        detailCardVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Baut die Google-Maps-URL für eine Wegbeschreibung zum aktuell ausgewählten Marker.
    /// Wichtig: InvariantCulture, damit Lat/Lon mit Punkt formatiert werden
    /// (z. B. "53.5503" und NICHT "53,5503", was die URL kaputt machen würde).
    /// </summary>
    private string GetDirectionsUrl()
    {
        if (!selectedLat.HasValue || !selectedLon.HasValue) return "#";
        var lat = selectedLat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lon = selectedLon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"https://www.google.com/maps/dir/?api=1&destination={lat},{lon}";
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        uploadErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        // 1) Größe prüfen
        if (file.Size > MaxImageSizeBytes)
        {
            uploadErrorMessage = $"Bild zu groß ({file.Size / 1024 / 1024} MB). Maximal 5 MB erlaubt.";
            return;
        }

        // 2) Endung prüfen — wir akzeptieren nur Bildformate, die Browser zuverlässig anzeigen.
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        if (!allowed.Contains(ext))
        {
            uploadErrorMessage = "Nur JPG, PNG oder WebP erlaubt.";
            return;
        }

        // 3) Datei speichern unter eindeutigem Namen, damit zwei Uploads sich nie überschreiben.
        try
        {
            uploadingImage = true;
            StateHasChanged();

            var uploadsDir = Path.Combine(WebHostEnv.WebRootPath, "uploads");
            Directory.CreateDirectory(uploadsDir); // sicherstellen, dass der Ordner existiert

            var filename = $"{Guid.NewGuid()}{ext}";
            var fullPath = Path.Combine(uploadsDir, filename);

            await using (var outStream = File.Create(fullPath))
            await using (var inStream = file.OpenReadStream(MaxImageSizeBytes))
            {
                await inStream.CopyToAsync(outStream);
            }

            // Relative URL, die der Browser über MapStaticAssets erreichen kann.
            pendingPictureUrl = $"/uploads/{filename}";
        }
        catch (Exception ex)
        {
            uploadErrorMessage = $"Upload fehlgeschlagen: {ex.Message}";
            Console.WriteLine($"Image upload error: {ex}");
        }
        finally
        {
            uploadingImage = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// "Anderes Bild wählen": verwirft das aktuell hochgeladene Bild aus dem Draft
    /// und löscht die zugehörige Datei vom Server, weil der DB-Eintrag noch nicht
    /// gespeichert wurde und die Datei sonst orphan bleiben würde.
    /// </summary>
    private void SwapImage()
    {
        if (!string.IsNullOrEmpty(pendingPictureUrl) &&
            pendingPictureUrl.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var filename = Path.GetFileName(pendingPictureUrl);
                var fullPath = Path.Combine(WebHostEnv.WebRootPath, "uploads", filename);
                if (File.Exists(fullPath))
                {
                    File.Delete(fullPath);
                }
            }
            catch (Exception ex)
            {
                // Datei-Cleanup ist nicht kritisch — der UI-Flow soll weiterlaufen,
                // auch wenn die alte Datei aus irgendeinem Grund nicht weg geht.
                Console.WriteLine($"Could not delete uploaded image file: {ex.Message}");
            }
        }

        pendingPictureUrl = null;
        uploadErrorMessage = null;
    }

