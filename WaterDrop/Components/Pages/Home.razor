    public record ReviewInfo(string? Comment, string? PictureUrl);

    [JSInvokable]
    public async Task<Dictionary<string, ReviewInfo>> GetReviewsForElements(string[] elementIdStrs)
    {
        var elementIds = elementIdStrs
            .Select(s => long.TryParse(s, out var id) ? id : 0L)
            .Where(id => id != 0)
            .ToArray();

        var records = await kloService.GetKlosByElementIds(elementIds);

        return records
            .Where(r => !string.IsNullOrEmpty(r.Comment) || !string.IsNullOrEmpty(r.PictureUrl))
            .ToDictionary(r => r.ElementId.ToString(), r => new ReviewInfo(r.Comment, r.PictureUrl));
    }

    private async Task SaveReview()
    {
        if (selectedElementId == 0) return;

        // Wenn weder Kommentar noch Bild vorhanden sind, gibt es nichts zu speichern.
        var hasContent = !string.IsNullOrWhiteSpace(reviewText) || !string.IsNullOrEmpty(pendingPictureUrl);
        if (!hasContent)
        {
            reviewSaveMessage = "Bitte gib einen Kommentar oder ein Bild ein, bevor du sendest.";
            StateHasChanged();
            return;
        }

        try
        {
            // Immer einen NEUEN Eintrag anlegen — die Historie pro Ort bleibt
            // dadurch erhalten. Nutzer können bestehende Reviews weder bearbeiten
            // noch löschen; sie können nur eigene Reviews hinzufügen.
            await kloService.AddKloCommentToData(new DatabaseKloModel
            {
                Id = Guid.NewGuid(),
                ElementId = selectedElementId,
                Comment = reviewText,
                PictureUrl = pendingPictureUrl
                // CreatedAt wird in kloService.AddKloCommentToData automatisch gesetzt.
            });

            // Karten-Popup mit dem gerade eingefügten (= neuesten) Review aktualisieren.
            await JS.InvokeVoidAsync("updateMarkersWithReviewAndPicture",
                selectedElementId.ToString(), reviewText, pendingPictureUrl);
            reviewSaveMessage = "Review erfolgreich gesendet.";
        }
        catch (Exception ex)
        {
            reviewSaveMessage = $"Fehler beim Senden: {ex.Message}";
            Console.WriteLine($"SaveReview error: {ex}");
        }

        StateHasChanged();
    }

